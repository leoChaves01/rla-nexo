# Configure in Vercel -> Project -> Settings -> Environment Variables.
# Do not upload a real .env or use NEXT_PUBLIC for secret keys.
NEXO_CLOUD=true
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Only enable with a Groq FREE account, without billing/payment method.
FREE_AI_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
