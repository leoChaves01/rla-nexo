# Copie para .env na raiz. PostgreSQL é obrigatório para preservar seus dados.
DATABASE_URL=
PORT=4000
HOST=127.0.0.1
# Obrigatório para persistência ou HOST diferente de loopback; mínimo 32 caracteres.
API_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# O provedor real ainda precisa ser implementado.
OPEN_FINANCE_PROVIDER=mock
